@echo off
REM ============================================================
REM  GPR Dataset -- GPU Simulation Runner
REM  Generated by generate_gpr_dataset.py
REM
REM  * Runs every .in file that has no matching .out (resumable).
REM  * Change -gpu to match your CUDA device ID (0, 1, ...).
REM  * Remove -gpu entirely to run on CPU.
REM ============================================================

set PYTHON=python.exe
set DATASET_DIR=d:\Codigo\Synth-GPR.bck\Synth-GPR-1\output\gpr_dataset_10k

echo.
echo [INFO] Starting gprMax simulations...
echo [INFO] Dataset : %DATASET_DIR%
echo [INFO] GPU     : 0
echo.

cd /d %DATASET_DIR%

set DONE=0
set SKIP=0

for %%f in (*.in) do (
    if not exist "%%~nf.out" (
        echo Running: %%f
        %PYTHON% -m gprMax "%%f" -gpu 0
        set /a DONE+=1
    ) else (
        set /a SKIP+=1
    )
)

echo.
echo [DONE] Simulations complete.  Run: %DONE%   Skipped: %SKIP%
pause
